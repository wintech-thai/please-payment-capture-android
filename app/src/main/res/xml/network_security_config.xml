<?xml version="1.0" encoding="utf-8"?>
<!-- In-house APK: webhook / probe endpoints may live on plain HTTP
     inside a private network. Allow cleartext for any host. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>

